# Server Configuration
PORT=3005
ALLOWED_ORIGINS=http://localhost:3005

# Payload and Rate Limiting
MAX_BODY_SIZE=16384
MAX_ADMIN_BODY_SIZE=
MAX_PROFILE_IMAGE_BYTES=
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_MAX_REQUESTS=5

# Admin Security
PORTFOLIO_ADMIN_TOKEN=your-secret-key-here
PORTFOLIO_SECURE_COOKIE=false
ADMIN_SESSION_TTL_MS=28800000
ADMIN_REMEMBER_TTL_MS=604800000

# Lead Management (Join a Discord channel and create a Webhook to get the URL)
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_TOKEN=
WEB3FORMS_ACCESS_KEY=

# Storage
MEDIA_STORAGE_DIR=
