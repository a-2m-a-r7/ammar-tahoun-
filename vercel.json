{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.js": {
      "runtime": "nodejs20.x",
      "includeFiles": "{data/**,media/**}"
    },
    "api/ai/**/*.js": {
      "runtime": "nodejs20.x",
      "maxDuration": 30,
      "includeFiles": "{data/**,media/**}"
    }
  },
  "rewrites": [
    { "source": "/media/(.*)", "destination": "/api/media?path=/media/$1" }
  ]
}
